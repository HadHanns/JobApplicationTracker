# SQLite Database Connection
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
# Ganti dengan domain production Anda jika sudah di-deploy (misal: https://offerly.vercel.app)
NEXTAUTH_URL="http://localhost:3000"
# Buat secret acak dengan: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-byte-secret-here"

# Google OAuth 2.0 Credentials
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application)
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

